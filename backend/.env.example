# Copy this file to ".env" and edit the values
PORT=3000

# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/pust_cse_resources
# Or MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/pust_cse_resources

# Change this to any long random text
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Default admin account (created by "npm run seed")
ADMIN_NAME=CSE Admin
ADMIN_EMAIL=admin@pust.ac.bd
ADMIN_PASSWORD=Admin@12345
